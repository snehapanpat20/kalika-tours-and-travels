# ─────────────────────────────────────────────────────────────
# Kalika Yatra: environment variables
#
# 1. Copy this file to .env.local  (it is ignored by git; never commit it)
# 2. Fill in the values below
# On your hosting provider, add the same names in its "Environment Variables" settings.
# NEVER put real values in this file.
# ─────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────
# PostgreSQL connection string.
#   Local:  postgresql://USER:PASSWORD@localhost:5432/kalika_dev
#   Neon / Supabase / Railway: copy the "connection string" they give you
#   (keep ?sslmode=require on the end if it is there).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/kalika_dev

# ── Security (required) ──────────────────────────────────────
# Long random secret that signs admin sessions. At least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use a different value in production, and keep it secret.
JWT_SECRET=

# ── Website address ──────────────────────────────────────────
# The public address of the site, no trailing slash.
#   Development: http://localhost:3000
#   Production:  https://your-domain.com
# Canonical URLs, the sitemap, robots.txt, sharing cards and structured data all use it,
# so it MUST be the real domain in production (the server warns if it is localhost).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Extra browser origins allowed to call the API, comma-separated.
# The site's own address (above) is always allowed; usually leave this empty.
# Never use *.
ALLOWED_ORIGINS=

# How many proxies sit in front of the app and add to X-Forwarded-For.
# 1 is correct for Vercel, Render, Railway or a single nginx. Used for rate limiting.
TRUSTED_PROXY_COUNT=1

# ── Admin ────────────────────────────────────────────────────
# Email for the admin login. Create the login with:  npm run admin:create
# (the password is typed at a hidden prompt; it is never stored in a file)
ADMIN_EMAIL=kalikatourstravels15@gmail.com

# ── Email notifications ──────────────────────────────────────
# Where "new enquiry" emails are sent. Defaults to the business email if empty.
NOTIFY_EMAIL=kalikatourstravels15@gmail.com

# smtp = send real email (production)
# log  = print emails in the server terminal instead (local development)
# none = do not send
EMAIL_TRANSPORT=smtp

# SMTP account used to send notifications. Two free options:
#  • Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USER=your Gmail address,
#    EMAIL_PASSWORD=a 16-character "App password" (Google Account → Security →
#    2-Step Verification → App passwords). Not your normal Gmail password.
#  • Brevo (300 emails/day free): EMAIL_HOST=smtp-relay.brevo.com, EMAIL_PORT=587,
#    EMAIL_USER / EMAIL_PASSWORD = the SMTP login and key from Brevo → SMTP & API.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
# Optional "From" line, e.g.  "Kalika Website" <kalikatourstravels15@gmail.com>
# For Gmail it must be your own address; for Brevo, a verified sender.
EMAIL_FROM=

# ── Photo uploads (fleet, gallery, review and content photos) ─
# local    = save uploads on this server's disk (folder below)
# supabase = save uploads in Supabase Storage (use this on Vercel; needs the three SUPABASE_* below)
# none     = uploads off. The admin can still add photos already in public/images,
#            and the review form hides its photo field.
# Either way photos are served by this site at /media/...
# Default: local in development, none in production. Only set local in production
# on a server with a PERMANENT disk (a VPS, or a Render/Railway persistent disk).
STORAGE_DRIVER=
# Upload folder for the local driver, relative to the project. Keep it out of public/ and back it up.
UPLOAD_DIR=storage/uploads

# Supabase Storage (only with STORAGE_DRIVER=supabase). SERVER-ONLY: never rename these
# to NEXT_PUBLIC_..., and never put the real key in this file.
#   SUPABASE_URL: Project Settings → API Keys → project URL (https://<project>.supabase.co)
#   SUPABASE_SECRET_KEY: a secret key (sb_secret_..., or the legacy service_role key).
#     It bypasses Row Level Security: keep it only in .env.local and the host's settings.
#   SUPABASE_STORAGE_BUCKET: the bucket name; keep the bucket private.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=fleet-photos

# ── Optional ─────────────────────────────────────────────────
# Only if the API is ever hosted on a different domain from the website.
NEXT_PUBLIC_API_BASE_URL=

# Leave empty until an analytics provider is chosen.
NEXT_PUBLIC_ANALYTICS_ID=
