# Settings for `npm run test:server` and `npm run test:api`.
# Copy to .env.test. The database name MUST end in _test: the tests empty its tables.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/kalika_test
# Any random string of 32+ characters (different from production)
JWT_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3200
ALLOWED_ORIGINS=http://localhost:3200
EMAIL_TRANSPORT=log
NOTIFY_EMAIL=owner@kalika.test
TRUSTED_PROXY_COUNT=1
TEST_BASE_URL=http://localhost:3200

# Photo uploads for the gallery and review tests (kept apart from development uploads)
STORAGE_DRIVER=local
UPLOAD_DIR=storage/test-uploads
